###  http://www.semanticweb.org/neupanek/ontologies/2023/10/CKG#attack_groups
:attack_groups rdf:type owl:Class ;
               rdfs:comment "attack groups that are capable of deploying software for breach" .


###  http://www.semanticweb.org/neupanek/ontologies/2023/10/CKG#campaigns
:campaigns rdf:type owl:Class ;
           rdfs:comment "campaigns launched by attack groups" .


###  http://www.semanticweb.org/neupanek/ontologies/2023/10/CKG#mitigation
:mitigation rdf:type owl:Class ;
            rdfs:comment "Mitigations that can prevent techniques" .


###  http://www.semanticweb.org/neupanek/ontologies/2023/10/CKG#software
:software rdf:type owl:Class ;
          rdfs:comment "Softwares used for attacks" .


###  http://www.semanticweb.org/neupanek/ontologies/2023/10/CKG#tactics
:tactics rdf:type owl:Class ;
         rdfs:comment "Tactics applied to accomplish techniques" .


###  http://www.semanticweb.org/neupanek/ontologies/2023/10/CKG#techniques
:techniques rdf:type owl:Class ;
            rdfs:comment "Techniques used in development of software" .


